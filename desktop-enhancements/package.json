{
  "name": "dsh-desktop-enhancements",
  "version": "0.1.0",
  "engines": {
    "dsh": "0.2.1-alpha.4"
  },
  "type": "module",
  "main": "index.mjs",
  "description": "Alpha.4-compatible conversation metrics and guarded registry-plugin updates",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.4",
    "semver": "^7.0.0",
    "yaml": "^2.0.0"
  },
  "license": "MIT"
}
